+//! Opt-in diagnostic metadata only; never reads or pins payload memory.
+use anyhow::{Context, Result};
+use std::fs::OpenOptions;
+use std::os::fd::AsRawFd;
+use std::path::Path;
+use std::ptr::NonNull;
+use std::sync::atomic::{AtomicU64, Ordering::SeqCst};
+
+pub(crate) const MAGIC: u64 = 0x31544f4c53425341;
+const WORDS: usize = 8;
+const UNIT: u64 = 512;
+const UNKNOWN: u64 = u64::MAX;
+
+// [magic, generation, address, capacity, logical_offset, valid_len, state, reads]
+// States: 1 allocated, 2 filling, 3 complete read, 4 before kernel overwrite,
+// 5 released, 6 failed/partial/non-read. Each mutation changes generation.
+pub struct SlotObservation {
+    row: NonNull<[AtomicU64; WORDS]>,
+    retain_during_fetch: bool,
+    map_len: usize,
+    segment_count: usize,
+}
+
+impl SlotObservation {
+    pub(crate) fn create(
+        image: &Path,
+        info: &ublk_sys::ublksrv_ctrl_dev_info,
+        qid: u16,
+        tag: u16,
+        address: u64,
+        capacity: u64,
+    ) -> Result<Option<Self>> {
+        let Some(dir) = std::env::var_os("AENV_PROVIDER_OBSERVE_DIR") else {
+            return Ok(None);
+        };
+        if !image.ends_with("memory/image.json") {
+            return Ok(None);
+        }
+        let dir = Path::new(&dir);
+        std::fs::create_dir_all(dir)?;
+        let stem = format!("{}-{}-{qid}-{tag}", std::process::id(), info.dev_id);
+        let path = dir.join(&stem).with_extension("bin");
+        let file = OpenOptions::new()
+            .write(true)
+            .read(true)
+            .create_new(true)
+            .open(path)?;
+        let retain_during_fetch = info.flags & ublk_sys::UBLK_F_NEED_GET_DATA as u64 != 0;
+        let segment_count = if retain_during_fetch {
+            anyhow::ensure!(
+                capacity.is_multiple_of(UNIT) && address.is_multiple_of(UNIT),
+                "segment observation requires sector-aligned buffers"
+            );
+            (capacity / UNIT) as usize
+        } else {
+            0
+        };
+        let map_len = (64 + segment_count * 16).div_ceil(4096) * 4096;
+        file.set_len(map_len as u64)?;
+        // SAFETY: the file covers map_len bytes; the mapping lives until Drop.
+        let ptr = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                map_len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                file.as_raw_fd(),
+                0,
+            )
+        };
+        anyhow::ensure!(
+            ptr != libc::MAP_FAILED,
+            "map slot metadata: {}",
+            std::io::Error::last_os_error()
+        );
+        let mut this = Self {
+            row: NonNull::new(ptr.cast()).context("null metadata mapping")?,
+            retain_during_fetch,
+            map_len,
+            segment_count,
+        };
+        this.words()[0].store(MAGIC, SeqCst);
+        this.words()[2].store(address, SeqCst);
+        this.words()[3].store(capacity, SeqCst);
+        this.update(0, 0, 1);
+        for entry in this.segments() {
+            entry[1].store(UNKNOWN, SeqCst);
+        }
+        let mut identity = serde_json::json!({"schema":1, "pid":std::process::id(),
+            "image_config":image, "dev_id":info.dev_id, "queue":qid, "slot":tag,
+            "nr_queues":info.nr_hw_queues, "queue_depth":info.queue_depth,
+            "max_io_buf_bytes":info.max_io_buf_bytes,
+            "negotiated_flags":info.flags,
+            "content_validity":if this.retain_during_fetch { "before_overwrite" } else { "before_fetch" },
+            "process_stat":std::fs::read_to_string("/proc/self/stat")?});
+        if segment_count > 0 {
+            identity["segments"] = serde_json::json!({"schema":1, "unit_bytes":UNIT,
+                "entry_offset":64, "entry_bytes":16, "count":segment_count});
+        }
+        std::fs::write(
+            dir.join(stem).with_extension("json"),
+            serde_json::to_vec(&identity)?,
+        )?;
+        Ok(Some(this))
+    }
+
+    fn words(&self) -> &[AtomicU64; WORDS] {
+        // SAFETY: mmap is aligned, initialized to zeros, and owned by this slot task.
+        unsafe { self.row.as_ref() }
+    }
+
+    fn segments(&self) -> &[[AtomicU64; 2]] {
+        // SAFETY: the aligned entries follow the unchanged 64-byte header, and
+        // segment_count entries fit inside the mapping owned by this slot.
+        unsafe {
+            std::slice::from_raw_parts(
+                self.row.as_ptr().cast::<u8>().add(64).cast(),
+                self.segment_count,
+            )
+        }
+    }
+
+    fn set_segments(&mut self, len: u64, offset: Option<u64>) {
+        let count = len.div_ceil(UNIT).min(self.segment_count as u64) as usize;
+        for (index, entry) in self.segments()[..count].iter().enumerate() {
+            entry[0].fetch_add(1, SeqCst);
+            entry[1].store(offset.map_or(UNKNOWN, |o| o + index as u64 * UNIT), SeqCst);
+            entry[0].fetch_add(1, SeqCst);
+        }
+    }
+
+    fn update(&mut self, offset: u64, len: u64, state: u64) {
+        let w = self.words();
+        w[1].fetch_add(1, SeqCst);
+        w[4].store(offset, SeqCst);
+        w[5].store(len, SeqCst);
+        w[6].store(state, SeqCst);
+        w[1].fetch_add(1, SeqCst);
+    }
+
+    pub(crate) fn begin(&mut self, offset: u64, len: u64, read: bool) {
+        if read {
+            self.set_segments(len, None);
+        }
+        self.update(offset, 0, 2);
+    }
+
+    pub(crate) fn complete(&mut self, read: bool, len: u64, result: i32) {
+        let offset = self.words()[4].load(SeqCst);
+        let valid = read
+            && len > 0
+            && len <= self.words()[3].load(SeqCst)
+            && result >= 0
+            && result as u64 == len;
+        if valid {
+            self.set_segments(len, Some(offset));
+            self.words()[7].fetch_add(1, SeqCst);
+        }
+        self.update(
+            offset,
+            if valid { len } else { 0 },
+            if valid { 3 } else { 6 },
+        );
+    }
+
+    pub(crate) fn before_fetch(&mut self) {
+        if !self.retain_during_fetch {
+            self.before_get_data(self.words()[3].load(SeqCst));
+        }
+    }
+
+    pub(crate) fn before_get_data(&mut self, len: u64) {
+        self.set_segments(len, None);
+        self.update(0, 0, 4);
+    }
+}
+
+impl Drop for SlotObservation {
+    fn drop(&mut self) {
+        self.set_segments(self.words()[3].load(SeqCst), None);
+        self.update(0, 0, 5);
+        // SAFETY: this mapping was created with exactly this length.
+        unsafe {
+            libc::munmap(self.row.as_ptr().cast(), self.map_len);
+        }
+    }
+}
+

+        assert_eq!(words[6].load(SeqCst), 2);
+        slot.complete(true, 4096, -libc::EIO);
+        slot.before_fetch();
+        assert_eq!(words[6].load(SeqCst), 6);
+    }
+
+    #[test]
+    fn reuse_failure_and_kernel_overwrite_invalidate() {
+        let mut words: [AtomicU64; WORDS] = std::array::from_fn(|_| AtomicU64::new(0));
+        words[3].store(8192, SeqCst);
+        // The test uses stack memory and must not run the mmap-specific Drop.
+        let mut slot = std::mem::ManuallyDrop::new(SlotObservation {
+            row: NonNull::from(&mut words),
+            retain_during_fetch: false,
+            map_len: 4096,
+            segment_count: 0,
+        });
+        slot.begin(4096, 4096, true);
+        slot.complete(true, 4096, 4096);
+        assert_eq!(words[5].load(SeqCst), 4096);
+        assert_eq!(words[6].load(SeqCst), 3);
+        let generation = words[1].load(SeqCst);
+        slot.before_fetch();
+        assert_eq!(words[5].load(SeqCst), 0);
+        assert_eq!(words[6].load(SeqCst), 4);
+        assert!(words[1].load(SeqCst) > generation);
+        for (read, len, result) in [
+            (true, 4096, 512),
+            (true, 4096, -5),
+            (false, 4096, 4096),
+            (true, 16384, 16384),
+            (true, 0, 0),
+        ] {
+            slot.begin(8192, 4096, true);
+            slot.complete(read, len, result);
+            assert_eq!(words[5].load(SeqCst), 0);
+            assert_eq!(words[6].load(SeqCst), 6);
+        }
+        assert_eq!(words[7].load(SeqCst), 1);
+        assert_eq!(words[1].load(SeqCst) % 2, 0);
+    }
+}

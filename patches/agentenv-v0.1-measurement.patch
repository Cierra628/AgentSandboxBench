diff --git a/storage/ublk-daemon/src/rootfs_copies.rs b/storage/ublk-daemon/src/rootfs_copies.rs
new file mode 100644
index 0000000..9f911f8
--- /dev/null
+++ b/storage/ublk-daemon/src/rootfs_copies.rs
@@ -0,0 +1,321 @@
+//! Explicit experiment-only initial-lower selection, before the image is opened.
+//! No data is copied or read here; Python prepares the fixed file sets first.
+use std::fs::{self, OpenOptions};
+use std::io::Write;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+use anyhow::{bail, ensure, Context, Result};
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+#[derive(Deserialize)]
+struct Layer {
+    digest: String,
+    file: PathBuf,
+    size: u64,
+}
+
+#[derive(Deserialize)]
+struct Plan {
+    version: u8,
+    mode: String,
+    runtime_root: PathBuf,
+    receipts: PathBuf,
+    copies: Vec<Vec<Layer>>,
+    #[serde(default = "default_schedule")]
+    schedule: String,
+}
+
+fn default_schedule() -> String {
+    "grpo".into()
+}
+
+pub(crate) fn apply(image: &mut Value, runtime_dir: &Path, manifest: Option<&Path>) -> Result<()> {
+    let Some(manifest) = manifest else {
+        return Ok(());
+    };
+    // Other runtime devices are not an experimental rootfs.
+    if runtime_dir
+        .file_name()
+        .is_none_or(|name| name != "overlaybd")
+    {
+        return Ok(());
+    }
+    let start = Instant::now();
+    let plan: Plan = serde_json::from_slice(&fs::read(manifest)?)?;
+    ensure!(plan.version == 1, "unsupported rootfs copy manifest");
+    let private = match plan.mode.as_str() {
+        "shared" => false,
+        "private" => true,
+        _ => bail!("unknown rootfs copy mode"),
+    };
+    ensure!(
+        runtime_dir.parent().and_then(Path::parent) == Some(plan.runtime_root.as_path()),
+        "rootfs copy request is outside the owned runtime root"
+    );
+    ensure!(
+        plan.copies.len() == if private { 7 } else { 1 },
+        "wrong copy-set count"
+    );
+    ensure!(
+        plan.copies.iter().all(|set| set.len() == 19),
+        "expected 19 initial lowers"
+    );
+    let lowers = image["lowers"]
+        .as_array_mut()
+        .context("missing rootfs lowers")?;
+    match plan.schedule.as_str() {
+        "grpo" => ensure!(
+            lowers.len() == 19,
+            "GRPO requires exactly 19 initial lowers"
+        ),
+        "bpo" => ensure!(
+            (19..=21).contains(&lowers.len()),
+            "BPO requires initial lowers and at most two generated lowers"
+        ),
+        _ => bail!("unsupported rootfs copy schedule"),
+    }
+    for generated in lowers.iter().skip(19) {
+        ensure!(
+            !generated["file"].as_str().unwrap_or_default().is_empty(),
+            "generated lower must remain local"
+        );
+        ensure!(
+            !plan.copies[0]
+                .iter()
+                .any(|base| generated["digest"].as_str() == Some(base.digest.as_str())),
+            "generated lower aliases an initial digest"
+        );
+    }
+    for (lower, expected) in lowers.iter().zip(&plan.copies[0]) {
+        ensure!(
+            lower["digest"].as_str() == Some(expected.digest.as_str()),
+            "initial lower order or digest changed"
+        );
+        ensure!(
+            lower["size"].as_u64() == Some(expected.size),
+            "initial lower size changed"
+        );
+        ensure!(
+            !lower["file"].as_str().unwrap_or_default().is_empty(),
+            "local lower file required"
+        );
+        for key in ["targetFile", "targetDigest", "gzipIndex"] {
+            ensure!(
+                lower[key].as_str().unwrap_or_default().is_empty(),
+                "auxiliary lower outside copy profile"
+            );
+        }
+    }
+    fs::create_dir_all(&plan.receipts)?;
+    let runtime_name = runtime_dir
+        .parent()
+        .and_then(Path::file_name)
+        .context("missing sandbox runtime name")?;
+    let receipt = plan.receipts.join(runtime_name).with_extension("json");
+    ensure!(!receipt.exists(), "rootfs runtime already assigned");
+    let slot = if private {
+        let mut assigned = None;
+        for index in 0..7 {
+            match OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(plan.receipts.join(format!("slot-{index}")))
+            {
+                Ok(mut claim) => {
+                    writeln!(claim, "{}", runtime_dir.display())?;
+                    assigned = Some(index);
+                    break;
+                }
+                Err(err) if err.kind() == std::io::ErrorKind::AlreadyExists => continue,
+                Err(err) => return Err(err.into()),
+            }
+        }
+        assigned.context("all seven rootfs copy sets are assigned")?
+    } else {
+        0
+    };
+    let mut observed = Vec::new();
+    for ((lower, selected), original) in lowers
+        .iter_mut()
+        .zip(&plan.copies[slot])
+        .zip(&plan.copies[0])
+    {
+        ensure!(
+            selected.digest == original.digest && selected.size == original.size,
+            "copy-set source differs"
+        );
+        ensure!(
+            selected.file.is_absolute(),
+            "absolute owned copy path required"
+        );
+        let info = fs::metadata(&selected.file)?;
+        ensure!(
+            info.is_file() && info.len() == selected.size,
+            "prepared rootfs copy size changed"
+        );
+        lower["file"] = json!(selected.file);
+        lower["dir"] = json!("");
+        observed.push(json!({"digest":selected.digest,"file":selected.file,
+            "device":info.dev(),"inode":info.ino(),"size":info.len()}));
+    }
+    // A failed creation keeps its claim as evidence; the experiment stops and
+    // its existing owned-volume cleanup handles the entire prepared set.
+    let mut output = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(receipt)?;
+    serde_json::to_writer_pretty(
+        &mut output,
+        &json!({"version":1,"mode":plan.mode,"schedule":plan.schedule,
+        "runtime_dir":runtime_dir,"slot":slot,"lowers":observed,
+        "metadata_elapsed_ns_before_receipt_write":start.elapsed().as_nanos()}),
+    )?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+
+    fn fixture(root: &Path, private: bool) -> (PathBuf, Value, PathBuf) {
+        let runtime_root = root.join("firecracker-work");
+        fs::create_dir(&runtime_root).unwrap();
+        let sets: Vec<_> = (0..if private { 7 } else { 1 })
+            .map(|slot| {
+                (0..19)
+                    .map(|index| {
+                        let file = root.join(format!("copy-{slot}-{index}"));
+                        fs::write(&file, b"test").unwrap();
+                        json!({"digest":format!("sha256:{index}"),"file":file,"size":4})
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .collect();
+        let image = json!({"lowers":sets[0],"upper":{"data":"unchanged"}});
+        let manifest = root.join("manifest.json");
+        fs::write(
+            &manifest,
+            serde_json::to_vec(&json!({"version":1,
+            "mode":if private {"private"} else {"shared"},"runtime_root":runtime_root,
+            "receipts":root.join("receipts"),"copies":sets}))
+            .unwrap(),
+        )
+        .unwrap();
+        (manifest, image, runtime_root)
+    }
+
+    #[test]
+    fn unset_preserves_original_and_non_rootfs_is_ignored() {
+        let mut image = json!({"anything":"original"});
+        let original = image.clone();
+        apply(&mut image, Path::new("/unused"), None).unwrap();
+        assert_eq!(image, original);
+        apply(&mut image, Path::new("/memory"), Some(Path::new("/absent"))).unwrap();
+        assert_eq!(image, original);
+    }
+
+    #[test]
+    fn seven_concurrent_creations_get_distinct_prepared_sets() {
+        let temp = tempfile::tempdir().unwrap();
+        let (manifest, image, root) = fixture(temp.path(), true);
+        let image = Arc::new(image);
+        let workers: Vec<_> = (0..7)
+            .map(|index| {
+                let (manifest, root, image) = (manifest.clone(), root.clone(), image.clone());
+                std::thread::spawn(move || {
+                    let mut value = (*image).clone();
+                    apply(
+                        &mut value,
+                        &root.join(format!("guest-{index}/overlaybd")),
+                        Some(&manifest),
+                    )
+                    .unwrap();
+                    assert_eq!(value["upper"]["data"], "unchanged");
+                    value["lowers"][0]["file"].as_str().unwrap().to_string()
+                })
+            })
+            .collect();
+        let files: std::collections::HashSet<_> =
+            workers.into_iter().map(|v| v.join().unwrap()).collect();
+        assert_eq!(files.len(), 7);
+        let mut extra = (*image).clone();
+        assert!(apply(&mut extra, &root.join("extra/overlaybd"), Some(&manifest)).is_err());
+    }
+
+    #[test]
+    fn shared_reuses_one_set_and_rejects_changed_sources_or_bpo() {
+        let temp = tempfile::tempdir().unwrap();
+        let (manifest, image, root) = fixture(temp.path(), false);
+        let mut first = image.clone();
+        let mut second = image.clone();
+        apply(&mut first, &root.join("first/overlaybd"), Some(&manifest)).unwrap();
+        apply(&mut second, &root.join("second/overlaybd"), Some(&manifest)).unwrap();
+        assert_eq!(first["lowers"], second["lowers"]);
+        let mut changed = image.clone();
+        changed["lowers"][0]["digest"] = json!("wrong");
+        assert!(apply(&mut changed, &root.join("bad/overlaybd"), Some(&manifest)).is_err());
+        let mut bpo = image.clone();
+        bpo["lowers"]
+            .as_array_mut()
+            .unwrap()
+            .push(json!({"file":"generated"}));
+        assert!(apply(&mut bpo, &root.join("bpo/overlaybd"), Some(&manifest)).is_err());
+        assert!(apply(
+            &mut image.clone(),
+            &temp.path().join("outside/guest/overlaybd"),
+            Some(&manifest)
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn bpo_replaces_repository_aliases_but_preserves_generated_lowers() {
+        let temp = tempfile::tempdir().unwrap();
+        let (manifest, image, root) = fixture(temp.path(), true);
+        let mut plan: Value = serde_json::from_slice(&fs::read(&manifest).unwrap()).unwrap();
+        plan["schedule"] = json!("bpo");
+        fs::write(&manifest, serde_json::to_vec(&plan).unwrap()).unwrap();
+        let mut selected = std::collections::HashSet::new();
+        for index in 0..7 {
+            let count = if index == 0 {
+                0
+            } else if index <= 3 {
+                1
+            } else {
+                2
+            };
+            let mut value = image.clone();
+            for lower in value["lowers"].as_array_mut().unwrap() {
+                lower["file"] = json!("/repository/remerged-original.commit");
+            }
+            let generated: Vec<_> = (0..count).map(|step| json!({"file":format!("/repository/generated-{step}"),"digest":format!("generated-{step}"),"size":4})).collect();
+            value["lowers"]
+                .as_array_mut()
+                .unwrap()
+                .extend(generated.clone());
+            apply(
+                &mut value,
+                &root.join(format!("guest-{index}/overlaybd")),
+                Some(&manifest),
+            )
+            .unwrap();
+            selected.insert(value["lowers"][0]["file"].as_str().unwrap().to_owned());
+            assert_eq!(
+                &value["lowers"].as_array().unwrap()[19..],
+                generated.as_slice()
+            );
+            assert_eq!(value["upper"], image["upper"]);
+        }
+        assert_eq!(selected.len(), 7);
+        let mut invalid = image.clone();
+        invalid["lowers"]
+            .as_array_mut()
+            .unwrap()
+            .extend([json!({}), json!({}), json!({})]);
+        assert!(apply(&mut invalid, &root.join("bad/overlaybd"), Some(&manifest)).is_err());
+    }
+}

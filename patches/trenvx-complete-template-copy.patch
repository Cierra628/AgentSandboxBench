+package build
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestTemplateCopyPreservesLargeSparseTail(t *testing.T) {
+	dir := t.TempDir()
+	src, dst := filepath.Join(dir, "source.img"), filepath.Join(dir, "target.img")
+	f, err := os.Create(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const size int64 = (2 << 30) + (2 << 20)
+	marker := []byte("ASB_COPY_TAIL")
+	if err = f.Truncate(size); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = f.WriteAt(marker, size-int64(len(marker))); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	if err = copyTemplateImage(src, dst); err != nil {
+		t.Fatal(err)
+	}
+	st, err := os.Stat(dst)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st.Size() != size {
+		t.Fatalf("short copy: %d != %d", st.Size(), size)
+	}
+	d, err := os.Open(dst)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	buf := make([]byte, len(marker))
+	if _, err = d.ReadAt(buf, size-int64(len(marker))); err != nil {
+		t.Fatal(err)
+	}
+	if string(buf) != string(marker) {
+		t.Fatalf("tail missing: %q", buf)
+	}
+}

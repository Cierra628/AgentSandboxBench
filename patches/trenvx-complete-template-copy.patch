+package build
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+)
+
+// The pinned reflink.Auto fallback ignores short copy_file_range results.
+// Coreutils handles partial copies and sparse files, while retaining reflink
+// when supported. Check length before presenting the image to the VMM.
+func copyTemplateImage(src, dst string) error {
+	source, err := os.Stat(src)
+	if err != nil {
+		return err
+	}
+	output, err := exec.Command("cp", "--reflink=auto", "--sparse=always",
+		"--preserve=mode,timestamps", "--", src, dst).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("copy template image: %w: %s", err, output)
+	}
+	target, err := os.Stat(dst)
+	if err != nil {
+		return err
+	}
+	if target.Size() != source.Size() {
+		return fmt.Errorf("incomplete template image: got %d bytes, want %d", target.Size(), source.Size())
+	}
+	return nil
+}

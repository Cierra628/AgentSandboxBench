+/* Snapshot helpers used only by the explicit named-file diagnostic query. */
+u64 asb_pagecache_generation(void)
+{
+	unsigned long flags;
+	u64 generation;
+	spin_lock_irqsave(&asb_lock, flags);
+	generation = asb_generation;
+	spin_unlock_irqrestore(&asb_lock, flags);
+	return generation;
+}
+
+u64 asb_pagecache_file_tag(struct address_space *mapping,
+		struct folio *folio, unsigned long offset)
+{
+	unsigned long flags, pfn = folio_pfn(folio) + offset;
+	u64 tag = 0;
+	spin_lock_irqsave(&asb_lock, flags);
+	if (folio->mapping == mapping && pfn < ASB_MAX_PFN &&
+	    test_bit(pfn, asb_present))
+		tag = asb_tags[pfn];
+	spin_unlock_irqrestore(&asb_lock, flags);
+	return tag;
+}
+

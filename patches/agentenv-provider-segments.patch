+    #[test]
+    fn segments_keep_older_tails_through_multiple_short_reads() {
+        let mut slot = segment_slot(4096);
+        assert_eq!(offsets(&slot), vec![UNKNOWN; 8]);
+        for (offset, len) in [(0, 4096), (10240, 2048), (20480, 1024)] {
+            slot.begin(offset, len, true);
+            assert!(offsets(&slot)[..(len / UNIT) as usize]
+                .iter()
+                .all(|o| *o == UNKNOWN));
+            slot.complete(true, len, len as i32);
+        }
+        assert_eq!(
+            offsets(&slot),
+            vec![20480, 20992, 11264, 11776, 2048, 2560, 3072, 3584]
+        );
+        let tail_generation = slot.segments()[7][0].load(SeqCst);
+        slot.begin(20480, 1024, true);
+        slot.complete(true, 1024, 1024);
+        assert_eq!(slot.segments()[7][0].load(SeqCst), tail_generation);
+        assert!(slot
+            .segments()
+            .iter()
+            .all(|e| e[0].load(SeqCst).is_multiple_of(2)));
+    }
+
+    #[test]
+    fn failed_partial_and_cancelled_prefixes_stay_unknown() {
+        let mut slot = segment_slot(4096);
+        for result in [-libc::EIO, -libc::ECANCELED, 512] {
+            slot.begin(0, 4096, true);
+            slot.complete(true, 4096, 4096);
+            slot.begin(10240, 2048, true);
+            slot.complete(true, 2048, result);

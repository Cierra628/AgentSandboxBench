+    pub fn get_data_for_slot(&self, tag: u16, buf: &IOBuffer) -> std::io::Result<RingFuture> {
+        let addr = match buf {
+            IOBuffer::User(buf) => buf.subslice(0, buf.len()).as_ptr() as u64,
+            IOBuffer::AutoReg(_) => unreachable!("GET_DATA requires a user buffer"),
+        };
+        self.send_io_cmd(
+            ublk_sys::UBLK_U_IO_NEED_GET_DATA,
+            ublk_sys::ublksrv_io_cmd {
+                q_id: self.queue_id,
+                tag,
+                result: 0,
+                addr,
+            },
+            None,
+        )
+    }
+
     pub fn io_desc(&self, tag: u16) -> Option<ublk_sys::ublksrv_io_desc> {
         self.io_desc.get(tag as usize).cloned()
     }
